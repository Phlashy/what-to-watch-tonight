# TMDB API key — get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Anthropic API key — required for the AI chat feature
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides (defaults shown)
# PORT=3001
# DB_PATH=~/movie-night-data/movies.db

# Optional shared password. Leave unset for zero-friction LAN use (default).
# If set, the app requires this password before anyone can use it — useful if
# you expose the app beyond your local network.
# APP_PASSWORD=

# Optional CORS allowlist (comma-separated origins). Unset = allow all (default).
# CORS_ORIGIN=https://movies.example.com
