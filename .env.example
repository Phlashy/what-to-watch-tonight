# TMDB API key — get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Anthropic API key — required for the AI chat feature
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides (defaults shown)
# PORT=3001
# DB_PATH=~/movie-night-data/movies.db

# Optional shared password. Leave unset for zero-friction LAN use (default).
# If set, the app requires this password before anyone can use it — useful if
# you expose the app beyond your local network.
# APP_PASSWORD=

# Optional push alert (via https://ntfy.sh) when someone makes 20 wrong
# password guesses in an hour. Unset = no alerts. Only matters with APP_PASSWORD.
# NTFY_TOPIC=your-private-topic-name
# Name shown in those alerts, if you run more than one instance (default "Movie Night").
# WTWT_REPORT_NAME=Movie Night

# Optional CORS allowlist (comma-separated origins). Unset = allow all (default).
# CORS_ORIGIN=https://movies.example.com
